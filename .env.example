# JWT expiration time in seconds (e.g., 3600 for 1 hour)
JWT_EXPIRATION_TIME=3600

# IAM provider to use (e.g., 'cognito', 'custom')
IAM_PROVIDER=cognito

# AWS region where your resources are deployed
AWS_REGION=us-east-1

# AWS access key ID for programmatic access
AWS_ACCESS_KEY_ID=your_access_key_here

# AWS secret access key paired with the access key ID
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Token provider to use (e.g., 'bearer', 'opaque')
TOKEN_PROVIDER=bearer
